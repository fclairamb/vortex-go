<p class="note" data-testid="speed-machine">Measured on {{.Machine}}, at commit <code>{{.Commit}}</code>, on {{.Date}}. {{.Versions}}.</p>
<div class="legend"><span><i class="go"></i>vortex-go</span><span><i class="rust"></i>Rust</span><span>
<i class="parquet"></i>parquet-go</span></div>
<div class="table-wrap">
<table data-testid="speed-table">
<thead><tr><th>Case</th><th class="num">Threads</th><th class="num">vortex-go</th><th class="num">Rust</th>
<th class="num">parquet-go</th><th class="num">Go vs Rust</th></tr></thead>
<tbody>
{{range .Rows}}<tr data-testid="speed-row-{{.Index}}"><td>{{.Name}}</td>
{{- /* line break */ -}}
<td class="num">{{.Threads}}</td><td class="num">{{.Go}}</td><td class="num">{{.Rust}}</td>
{{- /* line break */ -}}
<td class="num">{{.Parquet}}</td><td class="num {{.Class}}">{{.Ratio}}</td></tr>
{{end}}</tbody>
</table>
</div>
<h3>As bars</h3>
<p class="note">Within a case, the longest bar is the slowest. Shorter is better.</p>
<svg data-testid="speed-chart" role="img" aria-label="Time per case for vortex-go, Rust and parquet-go" viewBox="0 0 640 {{.Height}}" width="640" height="{{.Height}}">
{{range .Groups}}<g data-testid="speed-bars-{{.Index}}" transform="translate(0 {{.Y}})">
<text x="0" y="{{.Height}}" class="muted">{{.Label}}</text>
{{range .Bars}}<rect class="{{.Class}}" x="210" y="{{.Y}}" width="{{.W}}" height="8">
<title>{{.Label}}: {{.Value}}</title></rect>
<text x="{{.W}}" y="{{.Y}}" dx="216" dy="8" class="muted">{{.Value}}</text>
{{end}}</g>
{{end}}</svg>
